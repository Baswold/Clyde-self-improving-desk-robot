# Copy to .env and fill in.

# ── LLM backends ─────────────────────────────────────────────────────────────
# Pick one for text mode.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Which model to use for the conversation loop.
# Defaults: claude-sonnet-4-6 (Anthropic) or anthropic/claude-sonnet-4-6 (OR).
CLYDE_MODEL=

# Which model `think` uses for writing new tools (defaults to CLYDE_MODEL).
CLYDE_THINK_MODEL=

# Which model the critic / notice loop / bus-ask-handler use
# (defaults to CLYDE_MODEL — short single-shot calls, cheap models OK).
CLYDE_CRITIC_MODEL=

# Which model handles vision (defaults to CLYDE_MODEL; needs vision support).
CLYDE_VISION_MODEL=

# ── Identity & inter-instance bus ────────────────────────────────────────────
# Name this instance announces over the bus (defaults to hostname).
# Set to e.g. 'clyde' on the desk and 'gerald' on the Pi.
CLYDE_INSTANCE_NAME=

# Bus: set CLYDE_HUB=1 on the instance that should run the hub.
# Set CLYDE_HUB_HOST on every other instance to point at the hub's IP.
# Both blank = bus disabled.
CLYDE_HUB=
CLYDE_HUB_HOST=
CLYDE_HUB_PORT=8765

# ── Voice (Qwen3-Omni Realtime via DashScope) ────────────────────────────────
DASHSCOPE_API_KEY=
# CLYDE_VOICE_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime?model=qwen3-omni-flash-realtime
# CLYDE_VOICE=Cherry   # built-in voice timbre

# Voice cloning: path to a short reference WAV. Gives this instance its
# own voice — useful for Gerald sounding different to Clyde.
CLYDE_VOICE_REF=

# ── Vision loop ──────────────────────────────────────────────────────────────
# Seconds between presence checks. 0 disables. Off by default.
CLYDE_VISION_INTERVAL=0
# Webcam device index or path. Defaults to 0.
WEBCAM_DEVICE=0

# ── Notice loop ──────────────────────────────────────────────────────────────
# Seconds between scans for things worth nudging unprompted.
# 0 disables. Default 1800 (30 min).
CLYDE_NOTICE_INTERVAL=1800

# ── Deploy ──────────────────────────────────────────────────────────────────
# Pi to deploy to (the other one — Gerald).
GERALD_HOST=192.168.0.130
GERALD_USER=basil
