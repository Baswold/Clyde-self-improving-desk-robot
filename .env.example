# Copy to .env and fill in

# Voice mode — Qwen Omni Realtime (get from console.alibabacloud.com, Singapore region)
DASHSCOPE_API_KEY=

# Text mode fallback — pick one
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: which model to use for the main conversation loop in text mode
# Defaults to claude-sonnet-4-6 (Anthropic) or anthropic/claude-sonnet-4-6 (OpenRouter)
CLYDE_MODEL=

# Pi to deploy to (the other one — Gerald)
GERALD_HOST=192.168.0.130
GERALD_USER=basil
