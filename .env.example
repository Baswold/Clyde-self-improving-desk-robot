# Copy to .env and fill in.

# Voice mode — Qwen3-Omni Realtime (DashScope, Singapore region works best).
# Get a key at https://dashscope.console.aliyun.com/ (intl) or aliyun.com (CN).
DASHSCOPE_API_KEY=

# Optional voice mode overrides
# CLYDE_VOICE_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime?model=qwen3-omni-flash-realtime
# CLYDE_VOICE=Cherry   # voice timbre; see DashScope docs for options

# Text mode — pick one
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: which model to use for the conversation loop in text mode.
# Defaults to claude-sonnet-4-6 (Anthropic) or anthropic/claude-sonnet-4-6 (OpenRouter).
CLYDE_MODEL=

# Optional: which model `think` uses for writing new tools.
CLYDE_THINK_MODEL=

# Pi to deploy to (the other one — Gerald)
GERALD_HOST=192.168.0.130
GERALD_USER=basil
